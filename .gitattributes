# ==========================================
# Line Ending Normalization
# ==========================================
# Automatically normalize line endings to LF for all text files
* text=auto eol=lf

# ==========================================
# Explicit Text File Declarations
# ==========================================
*.rs      text diff=rust
*.toml    text diff=toml
*.md      text
*.json    text
*.yml     text
*.yaml    text
LICENSE*  text

# ==========================================
# Binary Files Protection
# ==========================================
# Treat analysis samples, patches, and compiled binaries as true binary files
*.bin     binary
*.elf     binary
*.so      binary
*.dylib   binary
*.dll     binary
*.lib     binary
*.exe     binary
