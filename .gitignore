# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Orev Binary Analysis Artifacts
# ==========================================
# Target binaries in samples/ are usually large and shouldn't be committed to git
/samples/*
!/samples/.gitkeep

# Core dumps, logs, and temporary debugging outputs
*.core
*.dmp
*.log
*.tmp
